# ═══════════════════════════════════════════════════════════════
# Ayan Taraz — Production Environment Variables (1405)
# ═══════════════════════════════════════════════════════════════
#
# این فایل فقط برای مرجع است.
# فایل .env واقعی توسط ./deploy.sh به‌صورت خودکار تولید می‌شود.
#
# ── نحوه استفاده ──
# کافیست اجرا کنید:
#   ./deploy.sh
#
# اسکریپت خودکار:
#   ✓ پسورد PostgreSQL تصادفی تولید می‌کند
#   ✓ JWT Secret 256-bit تولید می‌کند
#   ✓ شماره موبایل ادمین را از شما می‌پرسد
#   ✓ کلید SMS API را از شما می‌پرسد (می‌توانید خالی بگذارید)
#   ✓ فایل .env را با دسترسی 600 می‌سازد
#
# اگر می‌خواهید دستی بسازید، این فایل را کپی کنید:
#   cp .env.example .env
#   سپس مقادیر زیر را جای‌گذاری کنید
# ═══════════════════════════════════════════════════════════════

# ── General ──
NODE_ENV=production
PORT=4000

# ── Database (PostgreSQL) ──
# پسورد را خودتان تولید کنید: openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | head -c 32
POSTGRES_USER=ayan_user
POSTGRES_PASSWORD=__GENERATE_STRONG_PASSWORD__
POSTGRES_DB=ayan_taraz
DATABASE_URL=postgresql://ayan_user:__GENERATE_STRONG_PASSWORD__@postgres:5432/ayan_taraz?schema=public

# ── Redis ──
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# ── Auth / JWT ──
# تولید: openssl rand -hex 32
JWT_SECRET=__GENERATE_64_HEX_CHARS__
JWT_EXPIRES_IN=86400

# ── CORS — comma-separated list of allowed browser origins ──
# حالت IP-First: آدرس IP سرور
# برای دامنه: ./deploy.sh domain yourdomain.com
CORS_ORIGINS=http://YOUR_SERVER_IP,http://localhost

# ── Frontend (Next.js) build-time vars ──
# IMPORTANT: NEXT_PUBLIC_API_URL باید خالی (EMPTY) بماند در production!
# مرورگر از مسیر نسبی "/api" استفاده می‌کند که Nginx به backend پراکسی می‌کند.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_BASE_URL=http://YOUR_SERVER_IP
PUBLIC_BASE_URL=http://YOUR_SERVER_IP

# ── Seed super-admin phone numbers ──
# شماره موبایل ادمین ارشد (با کد کشور، بدون + و بدون ۰ اول)
# مثال: 989121234567,989123456789
SEED_SUPER_ADMIN_PHONES=989XXXXXXXXX

# ── SMS Provider (Kavenegar / Farapayamak / etc.) ──
# 🔑 کلید API سرویس پیامک خود را اینجا جای‌گذاری کنید
# اگر خالی باشد، OTP فقط در لاگ کنسول نمایش داده می‌شود (فقط حالت dev)
# در production حتماً تنظیم کنید تا کاربران بتوانند وارد شوند
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=

# ── Upload paths ──
UPLOAD_DIR=/app/uploads

# ═══════════════════════════════════════════════════════════════
# DOMAIN MODE — برای فعال‌سازی دامنه این مقادیر را ویرایش کنید
# سپس اجرا کنید: ./deploy.sh domain yourdomain.com
# ═══════════════════════════════════════════════════════════════
# NEXT_PUBLIC_BASE_URL=https://yourdomain.com
# PUBLIC_BASE_URL=https://yourdomain.com
# CORS_ORIGINS=https://yourdomain.com,http://YOUR_SERVER_IP
