# Ayan Taraz Production Env — fill in real secrets before deploying
NODE_ENV=production
PORT=4000

# Database
DATABASE_URL="postgresql://ayan_user:CHANGE_ME@postgres:5432/ayan_taraz"
POSTGRES_USER=ayan_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ayan_taraz

# Redis
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# Auth
JWT_SECRET=CHANGE_ME_64_CHARS
JWT_EXPIRES_IN=86400

# CORS — comma-separated list of allowed browser origins.
# The backend reads CORS_ORIGINS (split by comma) in src/main.ts.
CORS_ORIGINS=https://ayantaraz.com,http://localhost,http://localhost:3000

# Frontend (Next.js) build-time vars.
# NEXT_PUBLIC_API_URL MUST stay empty in production behind Nginx so the browser
# uses the relative "/api" path (proxied by Nginx to the backend). A non-empty
# internal URL like http://backend:4000 is NOT reachable from the browser and
# caused the admin panel half-load / infinite-refresh issue.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_BASE_URL=https://ayantaraz.com
PUBLIC_BASE_URL=https://ayantaraz.com

# Seed super-admin phone numbers (comma separated, international format)
SEED_SUPER_ADMIN_PHONES=

# SMS provider
SMS_API_KEY=CHANGE_ME
SMS_SENDER=CHANGE_ME
