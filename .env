# ═══════════════════════════════════════════════════════════════════════════
# Ayan Taraz — Production Environment Variables (1405)
# ═══════════════════════════════════════════════════════════════════════════
# این فایل توسط deploy.sh به‌صورت خودکار از .env.example ساخته می‌شود.
# فقط مقادیر «CHANGE_ME» و کلیدهای API را جای‌گذاری کنید.
#
# ── حالت IP-First (پیش‌فرض — بدون دامنه) ──
# سرور روی IP 202.133.91.13 و پورت ۸۰ کار می‌کند.
# برای فعال‌سازی دامنه، بخش «DOMAIN MODE» را در انتها ویرایش کنید
# و سپس: ./deploy.sh domain yourdomain.com
# ═══════════════════════════════════════════════════════════════════════════

# ── General ──
NODE_ENV=production
PORT=4000

# ── Database (PostgreSQL) ──
# توجه: این مقادیر در docker-compose استفاده می‌شوند.
# POSTGRES_PASSWORD حتماً قبل از دیپلوی تغییر کنید!
POSTGRES_USER=ayan_user
POSTGRES_PASSWORD=6742265133e41575038ec857285f0b5779098e6400c1dc4f
POSTGRES_DB=ayan_taraz
DATABASE_URL=postgresql://ayan_user:6742265133e41575038ec857285f0b5779098e6400c1dc4f@postgres:5432/ayan_taraz?schema=public

# ── Redis ──
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# ── Auth / JWT ──
# یک رشته ۶۴ کاراکتری تصادفی تولید کنید: openssl rand -hex 32
JWT_SECRET=0517d2e2ff537c7eda1f995298f0a843d7d53ade848ee39f64a6226ab8c692ae
JWT_EXPIRES_IN=86400

# ── CORS — comma-separated list of allowed browser origins ──
# حالت IP-First: آدرس IP سرور
# برای افزودن دامنه: ,https://yourdomain.com را اضافه کنید
CORS_ORIGINS=http://202.133.91.13,http://localhost

# ── Frontend (Next.js) build-time vars ──
# IMPORTANT: NEXT_PUBLIC_API_URL باید خالی (EMPTY) بماند در تولید!
# مرورگر از مسیر نسبی "/api" استفاده می‌کند که Nginx به backend پروکسی می‌کند.
# اگر این را پر کنید (مثلاً http://backend:4000) پنل ادمین نیمه‌بارگذاری می‌شود.
NEXT_PUBLIC_API_URL=
# حالت IP-First:
NEXT_PUBLIC_BASE_URL=http://202.133.91.13
PUBLIC_BASE_URL=http://202.133.91.13

# ── Seed super-admin phone numbers ──
# شماره موبایل‌های ادمین ارشد (با کاما جدا کنید، فرمت بین‌المللی)
# مثال: 989121234567,989123456789
SEED_SUPER_ADMIN_PHONES=09133374162,09134292329

# ── SMS Provider (Kavenegar / Farapayamak / etc.) ──
# کلید API را اینجا جای‌گذاری کنید
SMS_API_KEY=HCCzqA/kgYSWSY7DshtRvuprkcGmcMWREJ/O2JWIuGNbZ0A6VD2piBvo7vFCqRiA28u3pUUTq6SUw+I+ObiBAaj9AZwiTwJYur9WqW4QRS4=
SMS_SENDER=CHANGE_ME

# ── Upload paths ──
UPLOAD_DIR=/app/uploads

# ═══════════════════════════════════════════════════════════════════════════
# DOMAIN MODE — برای فعال‌سازی دامنه این بخش را ویرایش کنید
# سپس اجرا کنید: ./deploy.sh domain yourdomain.com
# ═══════════════════════════════════════════════════════════════════════════
# NEXT_PUBLIC_BASE_URL=https://yourdomain.com
# PUBLIC_BASE_URL=https://yourdomain.com
# CORS_ORIGINS=https://yourdomain.com,http://202.133.91.13
