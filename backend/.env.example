# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ayan_taraz?schema=public"

# ============================================
# REDIS
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# ============================================
# JWT (Session)
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1d

# ============================================
# OTP
# ============================================
OTP_EXPIRES_IN=300000 # 5 minutes in ms
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_WINDOW=900000 # 15 minutes in ms
OTP_RATE_LIMIT_MAX=3

# ============================================
# SMS PROVIDER (Example: Twilio)
# ============================================
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ============================================
# OBJECT STORAGE (Example: AWS S3)
# ============================================
STORAGE_PROVIDER=local
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=

# ============================================
# FILE UPLOAD
# ============================================
MAX_FILE_SIZE=5242880 # 5MB
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf,video/mp4

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
