# and prevents stale local node_modules / .env from leaking into the image.
node_modules
npm-debug.log
.env
.env.local
.env.*.local
dist
.git
.gitignore
.gitattributes
coverage
.nyc_output
test
spec
*.md
Dockerfile
.dockerignore
docker-compose*.yml
