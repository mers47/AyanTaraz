generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==============================
// کاربران و احراز هویت
// ==============================

model User {
  id            String    @id @default(uuid())
  phone         String    @unique
  phoneVerified Boolean   @default(false)
  firstName     String?
  lastName      String?
  avatar        String?
  role          UserRole  @default(USER)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  otps          OTP[]
  sessions      Session[]
  consultations ConsultationBooking[]
  articles      Article[]
  videos        Video[]
  miniBooks     MiniBook[]
  mediaUploads  Media[]
  reviewedTaxRuleVersions  TaxRuleVersion[] @relation("ReviewedTaxRuleVersions")
  publishedTaxRuleVersions TaxRuleVersion[] @relation("PublishedTaxRuleVersions")
  adminActions  AdminAction[]         @relation("AdminUser")

  @@index([phone])
  @@index([role])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  ipAddress String?
  userAgent String?

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model OTP {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  phone        String
  code         String
  type         OTPType  @default(PHONE_VERIFICATION)
  used         Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  ipAddress    String?
  attemptCount Int      @default(0)

  @@index([phone])
  @@index([expiresAt])
  @@index([used])
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum OTPType {
  PHONE_VERIFICATION
  BOOKING_VERIFICATION
}

// ==============================
// محتوا (مقالات، ویدیوها، مینی‌بوک‌ها)
// ==============================

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  parentId    String?
  parent      Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryToCategory")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  articles    Article[]
  videos      Video[]
  miniBooks   MiniBook[]

  @@index([slug])
  @@index([parentId])
}

model Tag {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  articles  Article[]
  videos    Video[]

  @@index([slug])
}

model Article {
  id            String        @id @default(uuid())
  title         String
  slug          String        @unique
  excerpt       String?
  content       String        @db.Text
  status        ContentStatus @default(DRAFT)
  featuredImage String?
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  tags       Tag[]

  relatedArticles ArticleRelation[] @relation("FromArticle")
  relatedBy       ArticleRelation[] @relation("ToArticle")
  taxTopics       TaxTopic[]

  @@index([slug])
  @@index([status])
  @@index([categoryId])
  @@index([publishedAt])
}

model Video {
  id          String        @id @default(uuid())
  title       String
  slug        String        @unique
  description String?
  url         String
  thumbnail   String?
  duration    Int?
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  tags       Tag[]

  @@index([slug])
  @@index([status])
}

model MiniBook {
  id          String        @id @default(uuid())
  title       String
  slug        String        @unique
  description String?
  fileUrl     String
  coverImage  String?
  pageCount   Int?
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])

  @@index([slug])
  @@index([status])
}

model ArticleRelation {
  id            String @id @default(uuid())
  fromArticleId String
  fromArticle   Article @relation("FromArticle", fields: [fromArticleId], references: [id], onDelete: Cascade)
  toArticleId   String
  toArticle     Article @relation("ToArticle", fields: [toArticleId], references: [id], onDelete: Cascade)
  sortOrder     Int    @default(0)
  createdAt     DateTime @default(now())

  @@unique([fromArticleId, toArticleId])
  @@index([fromArticleId])
  @@index([toArticleId])
}

enum ContentStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

// ==============================
// رسانه
// ==============================

model Media {
  id           String   @id @default(uuid())
  name         String
  fileName     String
  fileUrl      String
  fileSize     Int
  mimeType     String
  dimensions   String?
  altText      String?
  description  String?
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([uploadedById])
  @@index([mimeType])
}

// ==============================
// قوانین و موضوعات مالیاتی
// ==============================

model TaxTopic {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rules       TaxRule[]
  articles    Article[]

  @@index([slug])
}

model TaxSource {
  id           String   @id @default(uuid())
  name         String   @unique
  url          String?
  officialName String?
  description  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rules       TaxRuleVersion[]

  @@index([name])
}

model TaxRule {
  id          String   @id @default(uuid())
  topicId     String
  topic       TaxTopic @relation(fields: [topicId], references: [id])
  name        String
  slug        String   @unique
  description String?
  status      TaxRuleStatus @default(DRAFT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions    TaxRuleVersion[]

  @@index([topicId])
  @@index([slug])
  @@index([status])
}

model TaxRuleVersion {
  id            String   @id @default(uuid())
  ruleId        String
  rule          TaxRule  @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  version       Int
  content       String   @db.Text
  sourceId      String
  source        TaxSource @relation(fields: [sourceId], references: [id])
  effectiveFrom DateTime
  effectiveTo   DateTime?
  status        TaxRuleVersionStatus @default(DRAFT)
  reviewNotes   String?
  reviewedById  String?
  reviewedBy    User?    @relation("ReviewedTaxRuleVersions", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  publishedById String?
  publishedBy   User?    @relation("PublishedTaxRuleVersions", fields: [publishedById], references: [id])
  publishedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([ruleId, version])
  @@index([ruleId])
  @@index([effectiveFrom])
  @@index([effectiveTo])
  @@index([status])
}

enum TaxRuleStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
  SUPERSEDED
}

enum TaxRuleVersionStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
}

// ==============================
// دستیار مالیاتی (درخت تصمیم)
// ==============================

model TaxQuestion {
  id          String   @id @default(uuid())
  question    String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  options       TaxQuestionOption[]
  nextQuestions TaxQuestionFlow[] @relation("FromQuestion")
  prevQuestions TaxQuestionFlow[] @relation("ToQuestion")

  @@index([sortOrder])
  @@index([isActive])
}

model TaxQuestionOption {
  id         String   @id @default(uuid())
  questionId String
  question   TaxQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label      String
  value      String
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  flows      TaxQuestionFlow[]

  @@index([questionId])
  @@index([sortOrder])
}

model TaxQuestionFlow {
  id              String   @id @default(uuid())
  fromQuestionId  String
  fromQuestion    TaxQuestion @relation("FromQuestion", fields: [fromQuestionId], references: [id], onDelete: Cascade)
  toQuestionId    String
  toQuestion      TaxQuestion @relation("ToQuestion", fields: [toQuestionId], references: [id], onDelete: Cascade)
  optionId        String?
  option          TaxQuestionOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)
  condition       String?
  sortOrder       Int    @default(0)
  createdAt       DateTime @default(now())

  @@unique([fromQuestionId, optionId])
  @@index([fromQuestionId])
  @@index([toQuestionId])
}

model TaxAssistantResult {
  id          String   @id @default(uuid())
  name        String   @unique
  title       String
  description String   @db.Text
  ruleIds     String[]
  action      String?
  severity    TaxResultSeverity @default(INFO)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

enum TaxResultSeverity {
  INFO
  WARNING
  CRITICAL
  NEEDS_REVIEW
}

// ==============================
// مشاوره و رزرو
// ==============================

model ConsultationService {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String   @db.Text
  duration    Int
  price       Int?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  availability ConsultationAvailability[]
  bookings     ConsultationBooking[]

  @@index([slug])
  @@index([isActive])
}

model ConsultationAvailability {
  id        String   @id @default(uuid())
  serviceId String
  service   ConsultationService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startTime String
  endTime   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blockedPeriods ConsultationBlockedPeriod[]
  slots          ConsultationSlot[]

  @@unique([serviceId, dayOfWeek, startTime])
  @@index([serviceId])
  @@index([dayOfWeek])
}

model ConsultationSlot {
  id             String   @id @default(uuid())
  availabilityId String
  availability   ConsultationAvailability @relation(fields: [availabilityId], references: [id], onDelete: Cascade)
  date           DateTime
  startTime      DateTime
  endTime        DateTime
  maxBookings    Int      @default(1)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bookings       ConsultationBooking[]
  blockedPeriods ConsultationBlockedPeriod[]

  @@index([availabilityId])
  @@index([date])
  @@index([startTime])
}

model ConsultationBooking {
  id            String        @id @default(uuid())
  slotId        String
  slot          ConsultationSlot @relation(fields: [slotId], references: [id])
  serviceId     String
  service       ConsultationService @relation(fields: [serviceId], references: [id])
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  phone         String
  otpCode       String?
  otpVerified   Boolean  @default(false)
  status        BookingStatus @default(PENDING)
  notes         String?
  paymentStatus PaymentStatus @default(UNPAID)
  receiptUrl    String?
  receiptFileName String?
  amount        Int?
  paidAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([slotId])
  @@index([userId])
  @@index([phone])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model ConsultationBlockedPeriod {
  id             String   @id @default(uuid())
  slotId         String?
  slot           ConsultationSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)
  availabilityId String?
  availability   ConsultationAvailability? @relation(fields: [availabilityId], references: [id], onDelete: SetNull)
  startDate      DateTime
  endDate        DateTime
  reason         String?
  createdAt      DateTime @default(now())

  @@index([slotId])
  @@index([availabilityId])
  @@index([startDate, endDate])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  VERIFIED
  REJECTED
}

// ==============================
// سئو
// ==============================

model SEOConfig {
  id               String   @id @default(uuid())
  path             String   @unique
  title            String?
  description      String?
  canonical        String?
  ogTitle          String?
  ogDescription    String?
  ogImage          String?
  ogUrl            String?
  twitterCard      String?
  twitterTitle     String?
  twitterDescription String?
  twitterImage     String?
  schemaMarkup     String?  @db.Text
  indexable        Boolean  @default(true)
  followLinks      Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([path])
}

model Redirect {
  id         String   @id @default(uuid())
  fromPath   String   @unique
  toPath     String
  statusCode Int      @default(301)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([fromPath])
}

// ==============================
// ادمین و گزارش‌گیری
// ==============================

model AdminAction {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation("AdminUser", fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  oldValue   String?  @db.Text
  newValue   String?  @db.Text
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model AdminSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   @db.Text
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
}
